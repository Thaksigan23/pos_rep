# Copy this file to .env.local and fill in values from the Supabase project.
# Never commit .env.local. Never put the service-role / secret key in NEXT_PUBLIC_* vars.

# Project URL — Settings → API (or Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key. Use the anon key or the newer publishable key.
# Either name works; do not use the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Used later for privileged admin operations (invites, etc.).
# Never import this into Client Components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Public origin used in auth email redirects. Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Needed to apply SQL migrations from this repo:
# 1) Personal access token from https://supabase.com/dashboard/account/tokens
#    then: npx supabase login --token sbp_... && npx supabase link --project-ref YOUR_REF && npx supabase db push
# 2) Or a direct Postgres URI from Project Settings → Database
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# SUPABASE_ACCESS_TOKEN=sbp_YOUR_TOKEN
